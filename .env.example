# Runtime
# Node.js is used only to compile an edited runtime TPL into a CSP-safe revision cache.
FOXESCRAFT_NODE_BINARY=node
FOXESCRAFT_ENV=production
FOXESCRAFT_DEBUG=false
FOXESCRAFT_TIMEZONE=Europe/Amsterdam
# Comma-separated exact IPs or CIDR networks. Leave empty unless FoxCMS is behind a trusted reverse proxy.
FOXESCRAFT_TRUSTED_PROXIES=
# Optional bearer token protecting /api/health.php. Generate with: openssl rand -hex 32
FOXESCRAFT_HEALTH_TOKEN=

# Observability. lastlog.log remains newline-delimited JSON (one event per line).
FOXESCRAFT_SLOW_REQUEST_MS=2000
FOXESCRAFT_CRITICAL_REQUEST_MS=5000
FOXESCRAFT_MEMORY_WARNING_BYTES=67108864
# Optional HMAC key for privacy-preserving IP/User-Agent fingerprints in logs.
# Generate with: openssl rand -hex 32
FOXESCRAFT_LOG_FINGERPRINT_KEY=

# Runtime database account: DML only; do not grant CREATE, ALTER or DROP.
FOXESCRAFT_DB_HOST=127.0.0.1
FOXESCRAFT_DB_PORT=3306
FOXESCRAFT_DB_NAME=foxescraft
FOXESCRAFT_DB_USER=foxescraft
FOXESCRAFT_DB_PASSWORD=change-me
FOXESCRAFT_DB_CONNECT_TIMEOUT=5

# Public site
FOXESCRAFT_PUBLIC_BASE_URL=https://foxescraft.ru
FOXESCRAFT_SITE_TITLE=Лисий Мир 3.0
FOXESCRAFT_SITE_STATUS=IN DEVELOPMENT
FOXESCRAFT_TEMPLATE=foxengine2
FOXESCRAFT_LANGUAGE=ru
FOXESCRAFT_SITE_DESCRIPTION=Независимая игровая студия
FOXESCRAFT_SITE_KEYWORDS=FoxesCraft,FoxesWorld,Лисий Мир,GameDev,Minecraft
FOXESCRAFT_HOME_TITLE=Лисий Мир 3.0 — независимая игровая студия
FOXESCRAFT_TITLE_TEMPLATE=%page% — %site%
FOXESCRAFT_ROBOTS=index,follow
FOXESCRAFT_CANONICAL_URL=https://foxescraft.ru
FOXESCRAFT_LOCALE=ru_RU
FOXESCRAFT_AUTHOR=FoxesCraft
FOXESCRAFT_THEME_COLOR=#152019
FOXESCRAFT_FAVICON_URL=/favicon.ico
FOXESCRAFT_OG_SITE_NAME=FoxesCraft
FOXESCRAFT_OG_TITLE=FoxesCraft
FOXESCRAFT_OG_DESCRIPTION=Независимая игровая студия
FOXESCRAFT_OG_IMAGE=/uploads/site/social-cover.webp
FOXESCRAFT_TWITTER_CARD=summary_large_image
FOXESCRAFT_TWITTER_SITE=
FOXESCRAFT_TWITTER_CREATOR=
FOXESCRAFT_GOOGLE_VERIFICATION=
FOXESCRAFT_YANDEX_VERIFICATION=
FOXESCRAFT_BING_VERIFICATION=
FOXESCRAFT_CONTACT_EMAIL=admin@foxescraft.ru
FOXESCRAFT_CONTACT_PHONE=
FOXESCRAFT_DISCORD_LINK=
FOXESCRAFT_VK_LINK=
FOXESCRAFT_SERVICE_VERSION=3.0.0

# SMTP
FOXESCRAFT_SMTP_HOST=smtp.foxescraft.ru
FOXESCRAFT_SMTP_PORT=465
FOXESCRAFT_SMTP_SECURITY=ssl
FOXESCRAFT_SMTP_USERNAME=
FOXESCRAFT_SMTP_PASSWORD=
FOXESCRAFT_MAIL_TITLE=FoxesCraft
FOXESCRAFT_MAIL_METHOD=smtp

# reCAPTCHA
FOXESCRAFT_RECAPTCHA_ENABLED=false
FOXESCRAFT_RECAPTCHA_PUBLIC_KEY=
FOXESCRAFT_RECAPTCHA_SECRET_KEY=

# Integrations
FOXESCRAFT_DISCORD_APP_ID=
FOXESCRAFT_API_ACCESS_TOKEN=

# Minecraft achievement ingestion. JSON object: serverId => secret (minimum 32 bytes).
# Generate a secret with: openssl rand -hex 32
FOXESCRAFT_GAME_SERVER_KEYS_JSON='{"survival-eu-1":"replace-with-at-least-32-random-bytes"}'
FOXESCRAFT_GAME_HMAC_TOLERANCE_SECONDS=300

# Authentication and session policy
FOXESCRAFT_AUTH_BAN_MINUTES=20
FOXESCRAFT_AUTH_MAX_ATTEMPTS=5
FOXESCRAFT_AUTH_ATTEMPT_WINDOW_SECONDS=900
FOXESCRAFT_PASSWORD_MIN_LENGTH=10
FOXESCRAFT_LOGIN_MAX_LENGTH=64
FOXESCRAFT_DEFAULT_USER_GROUP_TAG=user
FOXESCRAFT_SESSION_IDLE_SECONDS=7200
FOXESCRAFT_SESSION_ABSOLUTE_SECONDS=86400
FOXESCRAFT_REMEMBER_SECONDS=31536000
# Create a welcome-back notification after this many inactive days (7-365).
FOXESCRAFT_WELCOME_BACK_DAYS=30
# Optional trusted reverse-proxy GeoIP header names. Leave empty unless the proxy overwrites them.
FOXESCRAFT_GEO_COUNTRY_HEADER=
FOXESCRAFT_GEO_REGION_HEADER=
FOXESCRAFT_GEO_CITY_HEADER=

# Launcher/runtime
FOXESCRAFT_GAME_FILES_DIR=game/
FOXESCRAFT_JRE_DIR=files/runtime/
FOXESCRAFT_LAUNCHER_SESSION_SECONDS=900
FOXESCRAFT_LAUNCHER_CATALOG_TTL=60
# Private token used only by KaylasLauncherBackend. It must match the production bridge token.
# Generate at least 32 random bytes; never commit the real value.
FOXESCRAFT_LAUNCHER_BRIDGE_TOKEN=

# Native bootstrap manifest and immutable artifact storage
# Keep this path outside application code only when the web server can read it.
FOXESCRAFT_BOOTSTRAP_STORAGE_DIRECTORY=/var/www/FoxCMS/uploads/bootstrap
FOXESCRAFT_BOOTSTRAP_CACHE_MAX_AGE=60
# Browser origins allowed to POST hardware inventory. Native launchers send no Origin header.
# Comma-separated exact http(s) origins; the origin from FOXESCRAFT_PUBLIC_BASE_URL is included automatically.
FOXESCRAFT_BOOTSTRAP_CORS_ORIGINS=
# Store the first privacy-safe hardware report for each hashed systemHWID.
FOXESCRAFT_HARDWARE_INVENTORY_ENABLED=true
FOXESCRAFT_HARDWARE_INVENTORY_MAX_BYTES=32768

# Optional monitoring paths
FOXESCRAFT_MONITOR_DAY_RECORD=
FOXESCRAFT_MONITOR_RECORD=
FOXESCRAFT_MONITOR_TEMP=

# Migration credentials are intentionally NOT stored here.
# Supply FOXESCRAFT_MIGRATION_DB_HOST/PORT/NAME/USER/PASSWORD only in the
# environment of `php scripts/migrate.php` or the deployment command.
# Deployment controls are also process-only:
# FOXESCRAFT_RUN_MIGRATIONS=true
# FOXESCRAFT_MIGRATE_USER_STORAGE=true
# FOXESCRAFT_ALLOW_UNVERIFIED_SCHEMA=false
