{
  "name": "foxesworld/foxescraft",
  "description": "FoxesCraft UUID-bound PHP engine and theme runtime",
  "type": "project",
  "require": {
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-phar": "*",
    "ext-session": "*",
    "php": ">=8.1"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "FoxCMS\\Api\\": "api/src/FoxCMS/Api/",
      "FoxCMS\\Engine\\": "engine/src/FoxCMS/Engine/",
      "FoxCMS\\Shared\\": "src/FoxCMS/Shared/"
    }
  }
}
