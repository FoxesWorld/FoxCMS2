<?php

declare(strict_types=1);

if (!defined('FOXXEY')) {
    http_response_code(403);
    exit('{"message":"Not in FOXXEY thread"}');
}

final class AntiBrute
{
    private const TABLE = 'antiBrute';

    private ?int $blockedUntil = null;
    private int $attempts = 0;
    private int $maxAttempts;
    private int $banSeconds;
    private int $attemptWindowSeconds;

    public function __construct(
        private string $ip,
        private db $db,
        private array $config,
        private Logger $logger,
        private bool $debug = false,
    ) {
        if (filter_var($this->ip, FILTER_VALIDATE_IP) === false) {
            throw new InvalidArgumentException('Invalid client IP address.');
        }

        $security = is_array($config['securitySetings'] ?? null)
            ? $config['securitySetings']
            : [];
        $this->maxAttempts = max(1, (int)($security['maxLoginAttempts'] ?? 5));
        $this->banSeconds = max(60, (int)($security['bantime'] ?? 20) * 60);
        $this->attemptWindowSeconds = max(60, (int)($security['attemptWindowSeconds'] ?? 900));

        $this->cleanupExpiredRecords();
        $this->loadRecord();
    }

    public function assertAllowed(): void
    {
        if ($this->blockedUntil === null || $this->blockedUntil <= CURRENT_TIME) {
            return;
        }

        $retryAfter = max(1, $this->blockedUntil - CURRENT_TIME);
        throw new AuthFailure(
            'Слишком много неудачных попыток входа. Повторите через ' . gmdate('H:i:s', $retryAfter) . '.',
            'authentication_rate_limited',
            429,
            headers: ['Retry-After' => (string)$retryAfter],
            severity: 'warning',
            expected: ['attemptsBelowLimit' => true],
            actual: [
                'attemptsBelowLimit' => false,
                'attempts' => $this->attempts,
                'maximumAttempts' => $this->maxAttempts,
                'retryAfterSeconds' => $retryAfter,
            ],
            auditContext: ['component' => 'anti_brute'],
        );
    }

    public function failedAuth(string $ip): void
    {
        $this->assertSameIp($ip);

        $statement = $this->db->prepare(
            'INSERT INTO `' . self::TABLE . '` (`ip`, `attempts`, `time`) '
            . 'VALUES (:ip, 1, NULL) '
            . 'ON DUPLICATE KEY UPDATE '
            . '`attempts` = `attempts` + 1, '
            . '`recordTime` = CURRENT_TIMESTAMP(4)'
        );
        $statement->execute([':ip' => $this->ip]);
        $this->loadRecord();

        $this->logger->deviation(
            'security.authentication.failed_attempt',
            'authentication_attempt_failed',
            'Failed authentication attempt was recorded.',
            $this->attempts >= $this->maxAttempts ? 'warning' : 'notice',
            ['attempts' => 0],
            [
                'attempts' => $this->attempts,
                'maximumAttempts' => $this->maxAttempts,
            ],
            ['component' => 'anti_brute'],
        );

        if ($this->attempts >= $this->maxAttempts) {
            $this->block();
            $this->assertAllowed();
        }
    }

    public function clearIp(string $ip): void
    {
        if (!hash_equals($this->ip, $ip)) {
            return;
        }

        $previousAttempts = $this->attempts;
        $wasBlocked = $this->blockedUntil !== null && $this->blockedUntil > CURRENT_TIME;
        $statement = $this->db->prepare(
            'DELETE FROM `' . self::TABLE . '` WHERE `ip` = :ip'
        );
        $statement->execute([':ip' => $this->ip]);

        $this->blockedUntil = null;
        $this->attempts = 0;
        if ($previousAttempts > 0 || $wasBlocked) {
            $this->logger->event(
                'security.authentication.failure_state_cleared',
                'Authentication failure state was cleared after successful authentication.',
                [
                    'component' => 'anti_brute',
                    'operation' => 'clear',
                    'previousAttempts' => $previousAttempts,
                    'wasBlocked' => $wasBlocked,
                ],
                'INFO',
                'success',
            );
        }
    }

    private function loadRecord(): void
    {
        $statement = $this->db->prepare(
            'SELECT `time`, `attempts` FROM `' . self::TABLE . '` WHERE `ip` = :ip LIMIT 1'
        );
        $statement->execute([':ip' => $this->ip]);
        $record = $statement->fetch(PDO::FETCH_ASSOC);

        if (!is_array($record)) {
            $this->blockedUntil = null;
            $this->attempts = 0;
            return;
        }

        $this->blockedUntil = $record['time'] === null ? null : (int)$record['time'];
        $this->attempts = max(0, (int)$record['attempts']);
        if ($this->debug) {
            $this->logger->debug('Anti-brute state loaded.', [
                'event' => 'security.authentication.state_loaded',
                'component' => 'anti_brute',
                'attempts' => $this->attempts,
                'maximumAttempts' => $this->maxAttempts,
                'blocked' => $this->blockedUntil !== null && $this->blockedUntil > CURRENT_TIME,
                'blockedUntil' => $this->blockedUntil,
            ]);
        }
    }

    private function block(): void
    {
        if ($this->blockedUntil !== null && $this->blockedUntil > CURRENT_TIME) {
            return;
        }

        $this->blockedUntil = CURRENT_TIME + $this->banSeconds;
        $statement = $this->db->prepare(
            'UPDATE `' . self::TABLE . '` SET `time` = :blockedUntil WHERE `ip` = :ip'
        );
        $statement->execute([
            ':blockedUntil' => $this->blockedUntil,
            ':ip' => $this->ip,
        ]);

        $this->logger->deviation(
            'security.authentication.blocked',
            'authentication_attempt_limit_reached',
            'Authentication attempts reached the configured limit and were temporarily blocked.',
            'warning',
            ['attemptsBelowLimit' => true],
            [
                'attemptsBelowLimit' => false,
                'attempts' => $this->attempts,
                'maximumAttempts' => $this->maxAttempts,
                'banSeconds' => $this->banSeconds,
            ],
            ['component' => 'anti_brute'],
        );
    }

    private function cleanupExpiredRecords(): void
    {
        $statement = $this->db->prepare(
            'DELETE FROM `' . self::TABLE . '` '
            . 'WHERE (`time` IS NOT NULL AND `time` < :currentTime) '
            . 'OR (`time` IS NULL AND `recordTime` < FROM_UNIXTIME(:attemptCutoff))'
        );
        $statement->execute([
            ':currentTime' => CURRENT_TIME,
            ':attemptCutoff' => CURRENT_TIME - $this->attemptWindowSeconds,
        ]);
    }

    private function assertSameIp(string $ip): void
    {
        if (!hash_equals($this->ip, $ip)) {
            throw new LogicException('Anti-brute-force request context mismatch.');
        }
    }
}
