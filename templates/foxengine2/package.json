    "audit:legacy": "node scripts/audit-legacy.mjs",
    "audit:legacy:baseline": "node scripts/audit-legacy.mjs --write-baseline",
    "check": "npm run check:utf8 && npm run check:i18n && npm run typecheck && npm run build && npm run check:csp-runtime && npm run check:assets && npm run check:emoticons && npm run check:runtime-options && npm run check:page-templates && npm run check:server-page && npm run check:server-storage && npm run check:ui && npm run check:admin-users && npm run check:admin-navigation && npm run check:admin-errors && npm run check:icons && npm run check:boundary && npm run check:frontend-registry && npm run check:frontend-architecture && npm run check:contracts && npm run check:news && npm run check:observability && npm run check:balance && npm run check:rewards && npm run check:auth && npm run check:sessions && npm run check:achievements && npm run check:bootstrap-hardware && npm run check:admin-hardware && npm run check:php && npm run check:php-architecture && npm run check:uploads && npm run check:slides && npm run check:mail && npm run check:runtime-jdks && npm run check:content && npm run check:groups && npm run check:identity && npm run check:maintenance && npm run check:secrets && npm run check:security-boundaries && npm run check:removed-runtime && npm run audit:legacy && npm run check:bundle",
    "check:assets": "node scripts/check-assets.mjs",
    "check:boundary": "node scripts/check-modern-boundary.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:balance": "node scripts/check-balance-matrix.mjs",
    "check:rewards": "node scripts/check-rewards.mjs",
    "check:auth": "node scripts/check-auth-errors.mjs",
    "check:bootstrap-hardware": "node scripts/check-bootstrap-hardware.mjs",
    "check:admin-hardware": "node scripts/check-admin-hardware.mjs",
    "check:php": "node scripts/check-php-syntax.mjs",
    "check:removed-runtime": "node scripts/check-removed-runtime.mjs",
    "check:php-architecture": "node scripts/check-php-architecture.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:security-boundaries": "node scripts/check-security-boundaries.mjs",
    "check:frontend-registry": "node scripts/check-frontend-registry.mjs",
    "check:groups": "node scripts/check-group-tags.mjs",
    "check:identity": "node scripts/check-uuid-identity.mjs",
    "check:maintenance": "node scripts/check-maintenance-mode.mjs",
    "check:uploads": "node scripts/check-upload-contract.mjs",
    "check:slides": "node scripts/check-slider-config.mjs",
    "check:content": "node scripts/check-runtime-content.mjs",
    "check:ui": "node scripts/check-ui-controls.mjs",
    "check:mail": "node scripts/check-mail-templates.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:runtime-jdks": "node scripts/check-runtime-jdk-catalog.mjs",
    "check:admin-users": "node scripts/check-admin-users.mjs",
    "check:admin-navigation": "node scripts/check-admin-navigation.mjs",
    "check:server-page": "node scripts/check-server-page.mjs",
    "check:observability": "node scripts/check-observability.mjs",
    "check:utf8": "node scripts/check-utf8.mjs",
    "check:admin-errors": "node scripts/check-admin-errors.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:news": "node scripts/check-news-archive.mjs",
    "check:server-storage": "node scripts/check-server-storage.mjs",
    "check:runtime-options": "node scripts/check-runtime-options.mjs",
    "check:emoticons": "node scripts/check-emoticons.mjs",
    "check:sessions": "node scripts/check-user-sessions.mjs",
    "check:achievements": "node scripts/check-game-achievements.mjs",
    "check:page-templates": "node scripts/check-page-templates.mjs",
    "build:runtime-templates": "node scripts/compile-runtime-templates.mjs",
    "check:csp-runtime": "node scripts/check-csp-runtime.mjs",
    "build:runtime-template-compiler": "node scripts/build-runtime-template-compiler.mjs",
    "check:frontend-architecture": "node scripts/check-frontend-architecture.mjs"
