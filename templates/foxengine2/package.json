    "@tiptap/starter-kit": "3.29.2",
    "@tiptap/vue-3": "3.29.2",
    "@yaireo/tagify": "^4.38.0",
    "codemirror": "^5.65.21",
    "vue": "3.5.40",
    "vue-router": "^4.6.4"
