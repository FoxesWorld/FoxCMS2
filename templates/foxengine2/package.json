    "@types/node": "latest",
    "@types/yaireo__tagify": "^4.27.0",
    "@vitejs/plugin-vue": "6.0.8",
    "php-parser": "^3.7.0",
    "typescript": "^5.9.3",
    "vite": "8.2.0",
    "vue-tsc": "3.3.8"
  },
  "description": "Autonomous FoxesCraft foxengine2 template and verification suite."
