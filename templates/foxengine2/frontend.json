{
  "schema": 1,
  "routes": [
    {
      "path": "/",
      "name": "home",
      "view": "HomeView",
      "title": "FoxesCraft"
    },
    {
      "path": "/news",
      "name": "news-list",
      "view": "NewsListView",
      "title": "Все публикации",
      "module": "News"
    },
    {
      "path": "/news/:id",
      "name": "news",
      "view": "NewsView",
      "title": "Новость",
      "props": true,
      "module": "News"
    },
    {
      "path": "/about",
      "name": "about",
      "view": "StaticContentView",
      "title": "О проекте",
      "props": {
        "pageId": "about"
      }
    },
    {
      "path": "/rules",
      "name": "rules",
      "view": "StaticContentView",
      "title": "Правила",
      "props": {
        "pageId": "rules"
      }
    },
    {
      "path": "/funding",
      "name": "funding",
      "view": "StaticContentView",
      "title": "Поддержать проект",
      "props": {
        "pageId": "funding"
      }
    },
    {
      "path": "/guides/draft",
      "name": "guide-draft",
      "view": "GuideDraftView",
      "title": "Черновик гайда"
    },
    {
      "path": "/guides/discord-access",
      "name": "discord-access",
      "view": "StaticContentView",
      "title": "Доступ к Discord",
      "props": {
        "pageId": "discord-access"
      }
    },
    {
      "path": "/badges",
      "name": "badges",
      "view": "BadgesView",
      "title": "Бейджи"
    },
    {
      "path": "/badges/:id",
      "name": "badge",
      "view": "BadgeView",
      "title": "Значок",
      "props": true
    },
    {
      "path": "/legal/privacy",
      "name": "privacy",
      "view": "StaticContentView",
      "title": "Конфиденциальность",
      "props": {
        "pageId": "privacy"
      }
    },
    {
      "path": "/legal/cookies",
      "name": "cookies",
      "view": "StaticContentView",
      "title": "Cookie",
      "props": {
        "pageId": "cookies"
      }
    },
    {
      "path": "/security/verified-libraries",
      "name": "verified-libraries",
      "view": "StaticContentView",
      "title": "Проверенные библиотеки",
      "props": {
        "pageId": "verified-libraries"
      }
    },
    {
      "path": "/security/unverified-libraries",
      "name": "unverified-libraries",
      "view": "StaticContentView",
      "title": "Непроверенные библиотеки",
      "props": {
        "pageId": "unverified-libraries"
      }
    },
    {
      "path": "/technology",
      "name": "technology",
      "view": "StaticContentView",
      "title": "Технологии",
      "props": {
        "pageId": "technology"
      }
    },
    {
      "path": "/roadmap",
      "name": "roadmap",
      "view": "StaticContentView",
      "title": "Roadmap",
      "props": {
        "pageId": "roadmap"
      }
    },
    {
      "path": "/admin",
      "name": "admin",
      "view": "AdminView",
      "title": "Управление",
      "auth": "user",
      "groups": [
        "admin"
      ],
      "module": "AdminPanel"
    },
    {
      "path": "/auth",
      "name": "auth",
      "view": "AuthView",
      "title": "Вход",
      "auth": "guest",
      "module": "AuthReg"
    },
    {
      "path": "/register",
      "name": "register",
      "view": "RegisterView",
      "title": "Регистрация",
      "auth": "guest",
      "module": "AuthReg"
    },
    {
      "path": "/lost-password",
      "name": "lost-password",
      "view": "LostPasswordView",
      "title": "Восстановление пароля",
      "auth": "guest",
      "module": "AuthReg"
    },
    {
      "path": "/reset-password",
      "name": "reset-password",
      "view": "ResetPasswordView",
      "title": "Новый пароль",
      "auth": "guest",
      "module": "AuthReg"
    },
    {
      "path": "/start",
      "name": "start",
      "view": "StartGameView",
      "title": "Начать игру",
      "module": "GameScanner",
      "props": {
        "pageId": "start"
      }
    },
    {
      "path": "/server/:value",
      "name": "server",
      "view": "ServerView",
      "title": "Сервер",
      "props": true,
      "module": "GameScanner"
    },
    {
      "path": "/settings/skin",
      "name": "skin-settings-redirect",
      "redirect": "/settings/profile?tab=appearance#minecraft-identity"
    },
    {
      "path": "/settings/profile/:value?",
      "name": "profile-settings",
      "view": "ProfileSettingsView",
      "title": "Настройки профиля",
      "auth": "user",
      "module": "UserSettings"
    },
    {
      "path": "/profile/:value",
      "name": "profile",
      "view": "ProfileView",
      "title": "Профиль",
      "props": true,
      "module": "UserSettings"
    },
    {
      "path": "/players",
      "name": "players",
      "view": "PlayersView",
      "title": "Наши игроки",
      "module": "UserTop"
    },
    {
      "path": "/:pathMatch(.*)*",
      "name": "fallback",
      "redirect": "/"
    }
  ],
  "navigation": [
